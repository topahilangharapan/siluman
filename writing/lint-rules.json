{
  "_comment": "Schema v2. Three tiers: hard_bans (regex, zero tolerance, formatting only), tell_words (statistical scoring vs human baseline rates), semantic_judge (headless Haiku intent check). Read by ~/.claude/hooks/writing-preset-lint. lambda = expected human occurrences per 1000 words; the refresh skill regenerates tell_words from the preset vocabulary but never touches hard_bans or statistics.",
  "max_retries": 2,
  "hard_bans": [
    {
      "name": "em dash (zero tolerance, user rule)",
      "pattern": "—"
    },
    {
      "name": "spaced en dash used as em dash",
      "pattern": " – "
    },
    {
      "name": "bullet with bold header (- **Term:** text)",
      "pattern": "(?m)^\\s*[-*]\\s+\\*\\*[^*\\n]+?(?::\\s*\\*\\*|\\*\\*\\s*[:—-])"
    },
    {
      "name": "horizontal rule",
      "pattern": "(?m)^\\s*(?:-{3,}|\\*{3,}|_{3,})\\s*$"
    },
    {
      "name": "Conclusion heading",
      "pattern": "(?mi)^#{1,6}\\s*conclusion\\b"
    },
    {
      "name": "curly double quotes",
      "pattern": "[“”]"
    },
    {
      "name": "emoji",
      "pattern": "[\\U0001F000-\\U0001FAFF\\u2600-\\u27BF\\u2B00-\\u2BFF\\uFE0F]"
    }
  ],
  "max_bold_spans": 3,
  "tell_words": [
    {"term": "delve", "lambda": 0.02, "variants": ["delve", "delves", "delving", "delved"]},
    {"term": "tapestry", "lambda": 0.02},
    {"term": "testament to", "lambda": 0.02},
    {"term": "it's worth noting", "lambda": 0.03, "variants": ["it's worth noting", "it is worth noting"]},
    {"term": "it's important to note", "lambda": 0.03, "variants": ["it's important to note", "it is important to note"]},
    {"term": "in conclusion", "lambda": 0.05},
    {"term": "in today's world", "lambda": 0.02},
    {"term": "in the digital age", "lambda": 0.02},
    {"term": "plays a significant role", "lambda": 0.03},
    {"term": "stands as", "lambda": 0.05},
    {"term": "continues to captivate", "lambda": 0.01},
    {"term": "leaves a lasting impact", "lambda": 0.02},
    {"term": "lasting legacy", "lambda": 0.05},
    {"term": "nestled in the heart of", "lambda": 0.01},
    {"term": "rich cultural heritage", "lambda": 0.02},
    {"term": "must-see destination", "lambda": 0.01},
    {"term": "ever-evolving", "lambda": 0.02, "variants": ["ever-evolving", "ever-changing", "rapidly evolving"]},
    {"term": "multifaceted", "lambda": 0.03},
    {"term": "synergy", "lambda": 0.05},
    {"term": "game-changing", "lambda": 0.03, "variants": ["game-changing", "game changer"]},
    {"term": "groundbreaking", "lambda": 0.05},
    {"term": "seamless", "lambda": 0.1, "variants": ["seamless", "seamlessly"]},
    {"term": "pivotal", "lambda": 0.1},
    {"term": "meticulous", "lambda": 0.1, "variants": ["meticulous", "meticulously"]},
    {"term": "showcase", "lambda": 0.1, "variants": ["showcase", "showcases", "showcasing", "showcased"]},
    {"term": "garner", "lambda": 0.1, "variants": ["garner", "garnered", "garners"]},
    {"term": "bolster", "lambda": 0.1, "variants": ["bolster", "bolstered", "bolsters"]},
    {"term": "underscore", "lambda": 0.1, "variants": ["underscores", "underscoring", "underscored"]},
    {"term": "foster", "lambda": 0.15, "variants": ["foster", "fostering", "fosters"]},
    {"term": "serves as", "lambda": 0.15},
    {"term": "boasts", "lambda": 0.1, "variants": ["boasts", "boasting"]},
    {"term": "unleash", "lambda": 0.1, "variants": ["unleash", "unleashed"]},
    {"term": "embark", "lambda": 0.1, "variants": ["embark", "embarked", "embarking"]},
    {"term": "transformative", "lambda": 0.1},
    {"term": "revolutionize", "lambda": 0.1, "variants": ["revolutionize", "revolutionized", "revolutionizing"]},
    {"term": "cutting-edge", "lambda": 0.1},
    {"term": "state-of-the-art", "lambda": 0.1},
    {"term": "paramount", "lambda": 0.1},
    {"term": "profound", "lambda": 0.2, "variants": ["profound", "profoundly"]},
    {"term": "intricate", "lambda": 0.15, "variants": ["intricate", "intricacies"]},
    {"term": "interplay", "lambda": 0.1},
    {"term": "vibrant", "lambda": 0.15},
    {"term": "bustling", "lambda": 0.1},
    {"term": "streamline", "lambda": 0.15, "variants": ["streamline", "streamlined", "streamlining"]},
    {"term": "rich history", "lambda": 0.1},
    {"term": "utilize", "lambda": 0.2, "variants": ["utilize", "utilizes", "utilizing", "utilized"]},
    {"term": "furthermore", "lambda": 0.3},
    {"term": "prior to", "lambda": 0.4},
    {"term": "due to the fact that", "lambda": 0.1},
    {"term": "in order to", "lambda": 0.8},
    {"term": "a wide range of", "lambda": 0.3},
    {"term": "experts believe", "lambda": 0.05},
    {"term": "critics argue", "lambda": 0.05},
    {"term": "widely regarded as", "lambda": 0.08},
    {"term": "observers note", "lambda": 0.02},
    {"term": "enduring", "lambda": 0.3},
    {"term": "crucial", "lambda": 0.8},
    {"term": "robust", "lambda": 0.6},
    {"term": "enhance", "lambda": 0.6, "variants": ["enhance", "enhances", "enhancing"]},
    {"term": "leverage", "lambda": 0.4, "variants": ["leverage", "leverages", "leveraging"]},
    {"term": "elevate", "lambda": 0.3, "variants": ["elevate", "elevates", "elevating"]},
    {"term": "unlock", "lambda": 0.4, "variants": ["unlock", "unlocks", "unlocking"]},
    {"term": "comprehensive", "lambda": 0.8}
  ],
  "tell_patterns": [
    {
      "name": "trailing -ing significance clause",
      "pattern": ",\\s+(?:highlighting|underscoring|showcasing|reflecting|emphasizing|cementing|demonstrating|signaling|signalling|illustrating|solidifying|reinforcing|underlining)\\b[^.\\n]*\\.",
      "lambda": 0.15
    },
    {
      "name": "negative parallelism (not just/only X, but Y)",
      "pattern": "\\bnot\\s+(?:just|only|merely)\\b[^.\\n]{0,80}?\\bbut\\b",
      "lambda": 0.15
    },
    {
      "name": "negative parallelism (it's not X, it's Y)",
      "pattern": "\\bit'?s\\s+not\\s+(?:about\\s+)?[^.\\n]{0,60}?[,;—-]\\s*it'?s\\b",
      "lambda": 0.1
    },
    {
      "name": "negative parallelism (no X, no Y, just Z)",
      "pattern": "\\bno\\s+\\w+,\\s*no\\s+\\w+[,—-]\\s*just\\b",
      "lambda": 0.05
    }
  ],
  "statistics": {
    "composite_z_threshold": 3.0,
    "per_term_z_cap": 8.0,
    "cluster_window_words": 100,
    "cluster_distinct_terms": 3,
    "burstiness_min_cv": 0.35,
    "burstiness_min_words": 150,
    "burstiness_min_sentences": 5
  },
  "semantic_judge": {
    "enabled": true,
    "model": "claude-haiku-4-5-20251001",
    "timeout_seconds": 45,
    "criteria": [
      "Figurative cliches: navigate/landscape/realm/journey/tapestry used metaphorically for vague sophistication (literal uses are fine)",
      "Significance inflation: claims that a subject reflects broader trends, shaped identity, or has lasting importance, without a named source",
      "Legacy or impact padding: closing a passage by summarizing the subject's importance or influence",
      "Weasel attribution: 'experts believe', 'many consider', 'widely regarded' without naming who",
      "Promotional or travel-guide tone: press-release phrasing, 'dedicated to delivering', 'must-see'",
      "Superficial analysis bolted onto facts: '...which demonstrates its commitment to quality'",
      "Synonym rotation: rotating through synonyms (the city / the metropolis / the urban center) to avoid repeating a noun",
      "Restating the user's request back before answering, or canned politeness scaffolding",
      "Rule-of-three overuse: multiple triplet constructions in a short text"
    ]
  }
}
